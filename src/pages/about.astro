---
import '../styles/about.scss';
import Layout from '../layouts/MainLayout.astro';
const currentPath = Astro.url.pathname;

// ! Update this variable EVERY TIME this page is updated
const dateUpdated = "September 5th, 2026"
---

<Layout
    title="About"
    currentPath={currentPath}
    description="About Joshua Randall"
>
    <!-- Intro -->
    <section class="about-hero">
        <div class="wrap about-hero__grid">
            <div class="about-hero__text">
                <p class="eyebrow"><span class="prompt">~$</span> cat about.md</p>
                <h1>Hi! I'm Josh.</h1>
                <p class="about-hero__roles">
                    Software/Web Developer · Linux/Tech Enthusiast
                </p>
                <div class="about-hero__copy">
                    <p>
                        I am a Software Engineer based in Detroit, MI. I have started to learn programming
                        in 2019-2020. I take 
                        interest in Linux/UNIX based systems, web development, and UI/UX design. I currently run CachyOS on my main desktop, and I have extensive experience in DIY distrubtions such as Arch, Gentoo, and Nix.
                        I run a small homelab cluster that used to be used for school.
                        I use both of these systems for software development purposes.
                        I graduated Eastern Michigan University in December 2025.
                    </p>
                    <p>
                        Besides coding and technology: I like graphic/motion design + video editing (was using Adobe from 2014 to 2024),
                        and I have played violin for 6 years before the COVID-19 pandemic. I also play PC games
                        such as Titanfall 2. Outside of the FPS genre, I play Super Smash Bros. Ultimate, Minecraft, and the Persona series.
                        Due to the rise and accessibility of the Steam Deck (and similar portable handhelds),
                        I've started to take special interest in the roguelike genre that has started to rise in the early 2020s, such as Hades I/II, Cult of the Lamb, Megabonk, Balatro, Inscryption, and more.
                    </p>
                    <p>
                        My <a class="link" href="/now">Now Page</a> consists of what my current projects and focuses are, and would highly recommend taking a look.
                    </p>
                </div>
                <div class="about-hero__cta">
                    <a class="button button--solid" href="/now"><i class="fa-solid fa-bolt" aria-hidden="true"></i> See what I'm up to now</a>
                    <a class="button" href="mailto:contact@joshrandall.net"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Email me</a>
                </div>
                <p class="about-hero__updated mono">Last updated: {dateUpdated}</p>
            </div>
            <figure class="about-hero__photo" data-reveal="right">
                <img src="/assets/Joshua-Randall-pfp.jpg" alt="Joshua Randall" />
            </figure>
        </div>
    </section>

    <!-- Technologies -->
    <section class="skills">
        <div class="wrap">
            <div class="section-head" data-reveal>
                <p class="eyebrow"><span class="prompt">~$</span> ls skills/</p>
                <h2>Technologies</h2>
            </div>

            <h3 class="category__titles"><i class="fa-solid fa-compact-disc" aria-hidden="true"></i> Operating Systems</h3>
            <div class="skills__category" data-reveal-stagger>
                <div class="skills__item">
                    <img src="/assets/cachyos.svg" alt="">
                    <h4>CachyOS</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/gentoo-icon-sm.png" alt="">
                    <h4>Gentoo</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/arch-linux.png" alt="">
                    <h4>Arch Linux</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-microsoft" aria-hidden="true"></i>
                    <h4>Windows</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-apple" aria-hidden="true"></i>
                    <h4>macOS</h4>
                </div>
                <div class="skills__item">
                    <img src="https://freepngimg.com/save/71407-suse-get-started-button-opensuse-mate-linux/1024x1024" alt="">
                    <h4>openSUSE</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/debian.png" alt="">
                    <h4>Debian</h4>
                </div>
            </div>

            <h3 class="category__titles"><i class="fa-solid fa-code" aria-hidden="true"></i> Languages</h3>
            <div class="skills__category" data-reveal-stagger>
                <div class="skills__item">
                    <i class="fa-brands fa-python" aria-hidden="true"></i>
                    <h4>Python</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-java" aria-hidden="true"></i>
                    <h4>Java</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-css3-alt" aria-hidden="true"></i>
                    <h4>CSS</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-html5" aria-hidden="true"></i>
                    <h4>HTML</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-square-js" aria-hidden="true"></i>
                    <h4>JavaScript</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/1_nLbfO_PdTSpeCdZQuUr8RQ.png" alt="">
                    <h4>Astro</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-sass" aria-hidden="true"></i>
                    <h4>SASS/SCSS</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/1200px-The_C_Programming_Language_logo.svg.png" alt="">
                    <h4>C</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-php" aria-hidden="true"></i>
                    <h4>PHP</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/vite_logo_icon_249258.png" alt="">
                    <h4>Vite</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-react" aria-hidden="true"></i>
                    <h4>React</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-rust" aria-hidden="true"></i>
                    <h4>Rust</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-solid fa-terminal" aria-hidden="true"></i>
                    <h4>Shell Script</h4>
                </div>
            </div>

            <h3 class="category__titles"><i class="fa-solid fa-rocket" aria-hidden="true"></i> Deployment</h3>
            <div class="skills__category" data-reveal-stagger>
                <div class="skills__item">
                    <i class="fa-brands fa-docker" aria-hidden="true"></i>
                    <h4>Docker</h4>
                </div>
                <div class="skills__item">
                    <i class="fab fa-cloudflare" aria-hidden="true"></i>
                    <h4>CloudFlare</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/68747470733a2f2f63616464797365727665722e636f6d2f7265736f75726365732f696d616765732f66617669636f6e2e706e67" alt="">
                    <h4>Caddy</h4>
                </div>
                
            </div>

            <h3 class="category__titles"><i class="fa-solid fa-server" aria-hidden="true"></i> Homelab</h3>
            <div class="skills__category" data-reveal-stagger>
                <div class="skills__item">
                    <img src="/assets/82976448.png" alt="">
                    <h4>Authentik</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/bitwarden-icon-512x512-qdi0py2h.png" alt="">
                    <h4>Bitwarden</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/nextcloud.svg" alt="">
                    <h4>Nextcloud</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-brands fa-gitlab" aria-hidden="true"></i>
                    <h4>Gitlab</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/debian.png" alt="">
                    <h4>Debian</h4>
                </div>
            </div>

            <h3 class="category__titles"><i class="fa-solid fa-computer" aria-hidden="true"></i> Main Desktop</h3>
            <div class="skills__category" data-reveal-stagger>
                <div class="skills__item">
                    <i class="fa-solid fa-microchip" aria-hidden="true"></i>
                    <h4>AMD Ryzen 5 5600X</h4>
                </div>
                <div class="skills__item">
                    <img src="https://cdn-icons-png.flaticon.com/512/3716/3716996.png" alt="">
                    <h4>NVIDIA RTX 3060 12GB</h4>
                </div>
                <div class="skills__item">
                    <img src="https://cdn-icons-png.flaticon.com/512/3962/3962832.png" alt="">
                    <h4>GIGABYTE B450 AORUS ELITE</h4>
                </div>
                <div class="skills__item">
                    <img src="https://cdn-icons-png.flaticon.com/512/4529/4529469.png" alt="">
                    <h4>2x Samsung 970 EVO</h4>
                </div>
                <div class="skills__item">
                    <img src="https://images.vexels.com/media/users/3/153161/isolated/preview/138505dfa285ee9c13107adbad9a7a0e-gaming-monitor-stroke-icon.png" alt="">
                    <h4>1440p 180hz</h4>
                </div>
                <div class="skills__item">
                    <i class="fa-solid fa-memory" aria-hidden="true"></i>
                    <h4>32GB 3100hz</h4>
                </div>
                <div class="skills__item">
                    <img src="/assets/cachyos.svg" alt="">
                    <h4>CachyOS</h4>
                </div>
            </div>
        </div>
    </section>
</Layout>
