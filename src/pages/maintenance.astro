---
import Layout from '../layouts/MainLayout.astro';
const currentPath = Astro.url.pathname;
---
<Layout title="Maintenance" currentPath={currentPath}>
    <section class="status-page">
        <div class="status-page__grid" aria-hidden="true"></div>
        <div class="wrap status-page__content">
            <i class="status-page__icon fa-solid fa-server" aria-hidden="true"></i>
            <h1>This service is currently under maintenance.</h1>
            <p>It should be back shortly. Check the status page for live updates on all JRH services.</p>
            <div class="status-page__actions">
                <a class="button button--solid" href="https://status.joshrandall.net"><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> View status page</a>
                <a class="button" href="/">Back home</a>
            </div>
        </div>
    </section>
</Layout>
