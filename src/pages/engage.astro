---
import Layout from '../layouts/MainLayout.astro';
const currentPath = Astro.url.pathname;
---
<Layout title="Engage" currentPath={currentPath} description="Engage has moved to ngage.lol.">
    <section class="status-page">
        <div class="status-page__grid" aria-hidden="true"></div>
        <div class="wrap status-page__content">
            <p class="eyebrow"><span class="prompt">~$</span> curl -IL /engage</p>
            <i class="status-page__icon fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            <h1>Engage has moved to a new domain.</h1>
            <p class="status-page__msg">HTTP/1.1 301 Moved Permanently → ngage.lol</p>
            <p>
                Thank you for participating in our experimental barebones deployment!
                We appreciate the support from our new and loyal users — please continue
                to enjoy our developing web app on our new domain.
            </p>
            <div class="status-page__actions">
                <a class="button button--solid" href="https://ngage.lol">Go to ngage.lol <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                <a class="button" href="/projects/engage">About the project</a>
            </div>
        </div>
    </section>
</Layout>
