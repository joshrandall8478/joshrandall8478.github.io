---
import '../styles/blog-list.scss';
import Layout from '../layouts/MainLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ListControls from '../components/ListControls.astro';
import { published, isArchived, searchText, readingTime } from '../utils/content.js';

const posts = published(import.meta.glob('./posts/*.md', { eager: true }));
const archivedCount = posts.filter(isArchived).length;
const currentPath = Astro.url.pathname;
---
<Layout
    title="Posts"
    currentPath={currentPath}
    description="Posts on Linux, homelab, self-hosting, and software by Joshua Randall."
>
    <section class="wrap">
        <header class="page-head">
            <p class="eyebrow">Writing</p>
            <h1>Posts</h1>
            <!-- <p class="page-head__sub">
                {posts.length} posts on Linux, homelab adventures, self-hosting, and
                whatever I'm building or breaking at the moment.
            </p> -->
        </header>
        <ListControls noun="posts" search archivedCount={archivedCount} />
        <div class="card-grid" data-reveal-stagger data-list>
            {posts.map((post, i) => (
                <ArticleCard
                    url={post.url}
                    title={post.frontmatter.title}
                    image={post.frontmatter.image}
                    date={post.frontmatter.date}
                    description={post.frontmatter.description}
                    readTime={readingTime(post)}
                    eager={i < 6}
                    archived={isArchived(post)}
                    hidden={isArchived(post)}
                    data-search={searchText(post)}
                />
            ))}
        </div>
    </section>
</Layout>
