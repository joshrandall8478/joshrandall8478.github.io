---
import '../styles/blog-list.scss';
import Layout from '../layouts/MainLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { published, readingTime } from '../utils/content.js';

const posts = published(import.meta.glob('./posts/*.md', { eager: true }));
const currentPath = Astro.url.pathname;
---
<Layout
    title="Posts"
    currentPath={currentPath}
    description="Posts on Linux, homelab, self-hosting, and software by Joshua Randall."
>
    <section class="wrap">
        <header class="page-head">
            <p class="eyebrow"><span class="prompt">~$</span> ls posts/ | wc -l</p>
            <h1>Posts</h1>
            <p class="page-head__sub">
                {posts.length} posts on Linux, homelab adventures, self-hosting, and
                whatever I'm building or breaking at the moment.
            </p>
        </header>
        <div class="card-grid" data-reveal-stagger>
            {posts.map((post, i) => (
                <ArticleCard
                    url={post.url}
                    title={post.frontmatter.title}
                    image={post.frontmatter.image}
                    date={post.frontmatter.date}
                    description={post.frontmatter.description}
                    readTime={readingTime(post)}
                    eager={i < 6}
                />
            ))}
        </div>
    </section>
</Layout>
