---
import '../styles/index.scss';
import Layout from '../layouts/MainLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { published, readingTime } from '../utils/content.js';

const posts = published(import.meta.glob('./posts/*.md', { eager: true }));
const projects = published(import.meta.glob('./projects/*.md', { eager: true }));
const latestPost = posts[0];
const latestProject = projects[0];
const currentPath = Astro.url.pathname;

// The hero name is split into letters at build time so the entrance
// animation needs no script; --i drives each letter's stagger.
let letterIndex = 0;
const nameWords = ['Joshua', 'Randall'].map((word) =>
    [...word].map((char) => ({ char, i: letterIndex++ }))
);
const roles = ['Software Developer', 'Computer Science Graduate', 'Linux Enthusiast', 'Homelab Operator'];
---
<Layout title="Home" currentPath={currentPath} flush>
    <!-- Mastodon Verification-->
    <link rel="me" href="https://hachyderm.io/@pursuit" />
    <link rel="me" href="https://emich.social/@jranda10" />
    <link rel="me" href="https://social.joshrandall.net/@josh" />
    <link rel="me" href="https://ohai.social/@pursuit" />

    <!-- Hero -->
    <section class="hero" id="top">
        <canvas class="hero__field" id="hero-field" aria-hidden="true"></canvas>
        <div class="hero__fallback" aria-hidden="true"></div>
        <div class="hero__veil" aria-hidden="true"></div>
        <div class="wrap hero__content">
            <p class="hero__eyebrow eyebrow eyebrow--center">Hello, I'm</p>
            <h1 class="hero__title">
                <!-- <span class="sr-only">Joshua Randall</span> -->
                <span class="hero__name" aria-hidden="true">
                    {nameWords.map((letters, w) => (
                        <span class:list={["hero__word" ]}>
                            {letters.map(({ char, i }) => (
                                <span class="hero__char" style={`--i: ${i}`}>{char}</span>
                            ))}
                        </span>
                    ))}
                </span>
            </h1>
            <p class="hero__roles">
                <span class="sr-only">{roles.join(', ')}</span>
                <span class="hero__role" aria-hidden="true" data-roles={JSON.stringify(roles)}>{roles[0]}</span>
            </p>
            <div class="hero__cta">
                <a class="button button--solid" href="/projects" data-magnetic>View projects <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                <a class="button" href="/about" data-magnetic>More about me</a>
            </div>
            <SocialLinks class="hero__social" />
        </div>
        <a class="hero__scroll" href="#latest" aria-label="Scroll down for more">
            <span class="hero__scroll-label">Scroll</span>
            <span class="hero__scroll-line" aria-hidden="true"></span>
        </a>
    </section>

    <!-- What I do -->
    <!-- <section class="home-section" id="featured">
        <div class="wrap">
            <div class="section-head" data-reveal>
                <p class="eyebrow">Focus</p>
                <h2>What I do</h2>
            </div>
            <div class="focus-grid" data-reveal-stagger>
                <article class="focus-card">
                    <div class="focus-card__top">
                        <span class="focus-card__num">01</span>
                        <i class="fa-solid fa-code" aria-hidden="true"></i>
                    </div>
                    <h3>Software &amp; Web</h3>
                    <p>
                        Full-stack development across React JSX/TSX, .NET Core, NextJS, and Astro —
                        from my debut in the public sector to private coding experiments.
                    </p>
                </article>
                <article class="focus-card">
                    <div class="focus-card__top">
                        <span class="focus-card__num">02</span>
                        <i class="fa-solid fa-server" aria-hidden="true"></i>
                    </div>
                    <h3>DevOps &amp; Homelab</h3>
                    <p>
                        A self-hosted cluster running Jellyfin, Nextcloud, GitLab, and more —
                        deployed with Docker, fronted by Caddy, secured behind Authentik SSO.
                    </p>
                </article>
                <article class="focus-card">
                    <div class="focus-card__top">
                        <span class="focus-card__num">03</span>
                        <i class="fa-solid fa-terminal" aria-hidden="true"></i>
                    </div>
                    <h3>Linux &amp; Open Source</h3>
                    <p>
                        Daily-driving Arch based systems, maintaining dotfiles, experimenting with GPU
                        passthrough, and sharing what breaks along the way.
                    </p>
                </article>
            </div>
        </div>
    </section> -->

    <!-- Latest activity -->
    <section class="home-section home-section--alt" id="latest">
        <div class="wrap">
            <div class="section-head section-head--row" data-reveal>
                <div>
                    <p class="eyebrow">Latest</p>
                    <h2>Recent activity</h2>
                </div>
                <div class="section-head__links">
                    <a class="link-arrow" href="/posts">All posts</a>
                    <a class="link-arrow" href="/projects">All projects</a>
                </div>
            </div>
            <div class="latest-grid" data-reveal-stagger>
                <ArticleCard
                    badge="Latest post"
                    url={latestPost.url}
                    title={latestPost.frontmatter.title}
                    image={latestPost.frontmatter.image}
                    date={latestPost.frontmatter.date}
                    description={latestPost.frontmatter.description}
                    readTime={readingTime(latestPost)}
                    eager
                />
                <ArticleCard
                    badge="Latest project"
                    url={latestProject.url}
                    title={latestProject.frontmatter.title}
                    image={latestProject.frontmatter.image}
                    date={latestProject.frontmatter.date}
                    description={latestProject.frontmatter.subtitle}
                    tools={latestProject.frontmatter.tools}
                    readTime={readingTime(latestProject)}
                    eager
                />
            </div>
            <a class="now-banner" href="/now" data-reveal>
                <span class="pulse-dot" aria-hidden="true"></span>
                <span class="now-banner__text"><em>Now</em> — see what I'm currently working on.</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </section>

    <!-- Contact -->
    <section class="home-section contact-section" id="contact">
        <div class="wrap">
            <div class="contact-card" data-reveal="zoom">
                <div class="contact-card__rings" aria-hidden="true"></div>
                <p class="eyebrow eyebrow--center">Contact</p>
                <h2 id="contact-heading">Want to get in touch?</h2>
                <p>
                    Email <a class="link" href="mailto:contact@joshrandall.net">contact@joshrandall.net</a> —
                    it keeps your message separate from my main inbox, so I can respond
                    quickly and appropriately.
                </p>
                <a class="button button--solid" href="mailto:contact@joshrandall.net" data-magnetic>
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Email me
                </a>
            </div>
        </div>
    </section>

    <script src="../scripts/hero.js"></script>
    <script>
        // Rotating contact heading.
        const headings = [
            'Get in contact.',
            'Have inquiries?',
            'Want to work together?',
            'Need help with something?',
            'Want to get in touch?',
            'Business idea?',
            'Project idea?',
        ];
        document.getElementById('contact-heading').textContent =
            headings[Math.floor(Math.random() * headings.length)];
    </script>
</Layout>
