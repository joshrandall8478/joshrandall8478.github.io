---
import '../styles/global.scss';
import Logo from './Logo.astro';

const { currentPath = "" } = Astro.props;
const links = [
    { href: "/", label: "Home" },
    { href: "/about", label: "About" },
    { href: "/now", label: "Now" },
    { href: "/posts", label: "Posts" },
    { href: "/projects", label: "Projects" },
    { href: "https://sso.joshrandall.net", label: "Services", external: true },
    { href: "https://status.joshrandall.net", label: "Uptime", external: true },
];
const normalize = (p) => (p.length > 1 ? p.replace(/\/+$/, "") : p);
const isActive = (href) => {
    if (href.startsWith("http")) return false;
    const path = normalize(currentPath || "");
    if (href === "/") return path === "/" || path === "";
    return path === href || path.startsWith(href + "/");
};
---
<header id="topbar" class="site-nav">
    <div class="wrap site-nav__inner">
        <a class="site-nav__brand" href="/" aria-label="Home">
            <Logo />
            <span class="site-nav__wordmark">joshrandall<span class="tld">.net</span></span>
        </a>
        <button class="site-nav__toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav-links">
            <span></span>
            <span></span>
        </button>
        <ul class="site-nav__links" id="site-nav-links">
            {links.map((link, i) => (
                <li style={`--i: ${i}`}>
                    <a
                        href={link.href}
                        class:list={[{ "is-active": isActive(link.href) }]}
                        aria-current={isActive(link.href) ? "page" : undefined}
                    >
                        {link.label}
                        {link.external && <i class="ext fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>}
                    </a>
                </li>
            ))}
        </ul>
    </div>
</header>

<script>
    const nav = document.getElementById('topbar');
    const toggle = nav.querySelector('.site-nav__toggle');
    const links = nav.querySelector('.site-nav__links');

    const setScrolled = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });

    const setOpen = (open) => {
        links.classList.toggle('is-open', open);
        nav.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('nav-locked', open);
    };

    toggle.addEventListener('click', () => setOpen(!links.classList.contains('is-open')));
    links.addEventListener('click', (e) => {
        if (e.target.closest('a')) setOpen(false);
    });
    window.matchMedia('(min-width: 921px)').addEventListener('change', () => setOpen(false));
</script>
