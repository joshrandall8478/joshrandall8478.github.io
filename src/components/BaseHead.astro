---
// Shared <head> content for every layout.
const SITE = "https://joshrandall.net";
const {
    title,
    description = "Joshua Randall — software developer, DevOps engineer, and Linux enthusiast.",
    image = "/assets/preview.png",
    imageAlt,
    path = "",
    type = "website",
    publishedDate,
    modifiedDate,
} = Astro.props;

const metaTitle = "Joshua Randall - " + title;

// GitHub Pages serves the trailing-slash form; keep og:url/canonical on it.
const normalizedPath = path === "" || path === "/" ? "/" : path.endsWith("/") ? path : path + "/";
const url = SITE + normalizedPath;

// Scrapers require absolute image URLs.
const imageUrl = image.startsWith("http") ? image : SITE + image;
const isDefaultImage = image === "/assets/preview.png";
const ogImageAlt = imageAlt || (isDefaultImage ? "Joshua Randall — joshrandall.net" : metaTitle);

const toIso = (value) => {
    if (!value) return null;
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? null : date.toISOString();
};
const publishedIso = toIso(publishedDate);
const modifiedIso = toIso(modifiedDate);
---
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content={description}>
<meta name="theme-color" content="#080b09">

<!-- Open Graph Data -->
<meta property="og:site_name" content="Joshua Randall">
<meta property="og:title" content={metaTitle}>
<meta property="og:type" content={type}>
<meta property="og:url" content={url}>
<meta property="og:description" content={description}>
<meta property="og:locale" content="en_US">
<meta property="og:image" content={imageUrl}>
<meta property="og:image:alt" content={ogImageAlt}>
{isDefaultImage && <meta property="og:image:width" content="2400">}
{isDefaultImage && <meta property="og:image:height" content="1260">}
{type === "article" && publishedIso && <meta property="article:published_time" content={publishedIso}>}
{type === "article" && modifiedIso && <meta property="article:modified_time" content={modifiedIso}>}
{type === "article" && <meta property="article:author" content="Joshua Randall">}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={metaTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={imageUrl}>
<meta name="twitter:image:alt" content={ogImageAlt}>

<!-- Fediverse Credits -->
<meta name="fediverse:creator" content="@pursuit@ohai.social">

<!-- Favicon, canonical, feeds -->
<link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
<link rel="canonical" href={url}>
<link rel="alternate" type="application/rss+xml" title="Joshua Randall — Posts" href="/rss.xml">

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

<!-- FontAwesome Javascript Link -->
<script is:inline src="https://kit.fontawesome.com/61a8afa681.js" crossorigin="anonymous"></script>
<title>{metaTitle}</title>

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J470W803CJ"></script>
<script src="../layouts/analytics.js"></script>
