---
import "../styles/joanne.scss";
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/topbar.astro';
import Footer from '../components/Footer.astro';
import { formatDate } from '../utils/content.js';

const { frontmatter } = Astro.props;
const currentPath = frontmatter.url ?? "";
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead
        title={frontmatter.title}
        description={frontmatter.description}
        image={frontmatter.image?.url}
        path={currentPath}
    />
</head>
<body>
    <!-- Navbar -->
    <TopBar currentPath="/posts" />
    <main class="site-main">
        <article class="article joanne">
            <div class="wrap article__inner">
                <a class="back-link" href="/posts"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All posts</a>
                <header class="article__head">
                    <p class="joanne__memoriam">{frontmatter.description}</p>
                    <h1 class="article__title">{frontmatter.title}</h1>
                    <div class="article__meta">
                        <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>Published {formatDate(frontmatter.date)}</span>
                        <span><i class="fa-regular fa-user" aria-hidden="true"></i>{frontmatter.author}</span>
                    </div>
                </header>
                <figure class="joanne__frame">
                    <div class="joanne__img" role="img" aria-label={frontmatter.image?.alt}></div>
                </figure>
                <div class="blog__content prose">
                    <slot />
                </div>
                <footer class="article__foot">
                    <a class="button" href="/posts"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to all posts</a>
                </footer>
            </div>
        </article>
    </main>
    <Footer />
    <script src="../scripts/joanne-post.js"></script>
</body>
</html>
