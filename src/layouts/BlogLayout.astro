---
import "../styles/blog.scss";
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/topbar.astro';
import Footer from '../components/Footer.astro';
import { formatDate, readingTime } from '../utils/content.js';

const { frontmatter, rawContent } = Astro.props;
const currentPath = frontmatter.url ?? "";
const readTime = readingTime(rawContent);
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead
        title={frontmatter.title}
        description={frontmatter.description}
        image={frontmatter.image?.url}
        imageAlt={frontmatter.image?.alt}
        path={currentPath}
        type="article"
        publishedDate={frontmatter.date}
    />
</head>
<body>
    <!-- Navbar -->
    <TopBar currentPath="/posts" />
    <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>
    <main class="site-main">
        <article class="article">
            <div class="wrap article__inner">
                <a class="back-link" href="/posts"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All posts</a>
                <header class="article__head">
                    <h1 class="article__title">{frontmatter.title}</h1>
                    <div class="article__meta">
                        <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>{formatDate(frontmatter.date)}</span>
                        <span><i class="fa-regular fa-user" aria-hidden="true"></i>{frontmatter.author}</span>
                        {readTime && <span><i class="fa-regular fa-clock" aria-hidden="true"></i>{readTime} min read</span>}
                    </div>
                    <figure class="article__cover">
                        <img src={frontmatter.image?.url} alt={frontmatter.image?.alt ?? frontmatter.title} />
                    </figure>
                </header>
                <div class="blog__content prose">
                    <slot />
                </div>
                <footer class="article__foot">
                    <a class="button" href="/posts"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to all posts</a>
                </footer>
            </div>
        </article>
    </main>
    <Footer />
    <button id="to-top" type="button" aria-label="Back to top"><i class="fa-solid fa-angle-up" aria-hidden="true"></i></button>
    <script src="../scripts/article.js"></script>
</body>
</html>
