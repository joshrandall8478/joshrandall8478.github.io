---
import '../styles/global.scss';
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/topbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    currentPath?: string;
    description?: string;
    image?: string;
    flush?: boolean;
}
const {
    title,
    currentPath = Astro.url.pathname,
    description,
    image,
    flush = false,
} = Astro.props;
---
<!DOCTYPE html>
<html id="mainHTML" lang="en">
<head>
    <BaseHead title={title} description={description} image={image} path={currentPath} />
</head>
<body>
    <!-- Navbar -->
    <TopBar currentPath={currentPath} />
    <!-- Main Content -->
    <main class:list={["site-main", { "site-main--flush": flush }]}>
        <slot />
    </main>
    <Footer />
    <script src="../scripts/reveal.js"></script>
</body>
</html>
