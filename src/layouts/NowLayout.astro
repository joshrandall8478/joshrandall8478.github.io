---
import '../styles/now.scss';
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/topbar.astro';
import Footer from '../components/Footer.astro';
import { formatDate } from '../utils/content.js';

const { frontmatter } = Astro.props;
const currentPath = "/now";
---
<!DOCTYPE html>
<html id="mainHTML" lang="en">
<head>
    <BaseHead
        title="Now"
        description="What Joshua Randall is working on, learning, and playing right now."
        image={frontmatter.image?.url}
        path={currentPath}
    />
</head>
<body>
    <!-- Navbar -->
    <TopBar currentPath={currentPath} />
    <!-- Main Content -->
    <main class="site-main">
        <article class="now">
            <div class="wrap now__inner">
                <header class="page-head">
                    <p class="eyebrow"><span class="prompt">~$</span> cat now.md</p>
                    <h1>What I'm doing <span class="now__accent">now</span></h1>
                    <p class="now__updated mono">
                        <span class="pulse-dot" aria-hidden="true"></span>
                        Last updated {formatDate(frontmatter.date)}
                    </p>
                </header>
                <figure class="now__cover" data-reveal>
                    <img id="now-img" src={frontmatter.image?.url} alt={frontmatter.image?.alt} />
                </figure>
                <blockquote class="now__note">
                    This is <a class="link" href="https://nownownow.com/about">a now page</a>.
                    If you have your own site, you should make one too.
                </blockquote>
                <div class="now-content prose">
                    <slot />
                </div>
            </div>
        </article>
    </main>
    <Footer />
    <script src="../scripts/reveal.js"></script>
</body>
</html>
