---
import "../styles/blog.scss";
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/topbar.astro';
import Footer from '../components/Footer.astro';
import { tools } from '../maps/tools.json';
import { formatDate } from '../utils/content.js';

const { frontmatter } = Astro.props;
const currentPath = frontmatter.url ?? "";
const updated = frontmatter.date !== frontmatter.originalDate ? frontmatter.date : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead
        title={frontmatter.title}
        description={frontmatter.subtitle}
        image={frontmatter.image?.url}
        imageAlt={frontmatter.image?.alt}
        path={currentPath}
        type="article"
        publishedDate={frontmatter.originalDate}
        modifiedDate={updated}
    />
</head>
<body>
    <!-- Navbar -->
    <TopBar currentPath="/projects" />
    <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>
    <main class="site-main">
        <article class="article">
            <div class="wrap article__inner">
                <a class="back-link" href="/projects"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All projects</a>
                <header class="article__head">
                    <p class="article__subtitle eyebrow">{frontmatter.subtitle}</p>
                    <h1 class="article__title">{frontmatter.title}</h1>
                    <div class="article__meta">
                        <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>Posted {formatDate(frontmatter.originalDate)}</span>
                        {updated && <span><i class="fa-solid fa-rotate" aria-hidden="true"></i>Updated {formatDate(updated)}</span>}
                    </div>
                    {frontmatter.tools?.length > 0 && (
                        <div class="article__tools">
                            {frontmatter.tools.map((tool) => (
                                <span class="chip"><i class={tools[tool]} aria-hidden="true"></i>{tool}</span>
                            ))}
                        </div>
                    )}
                    <figure class="article__cover">
                        <img src={frontmatter.image?.url} alt={frontmatter.image?.alt ?? frontmatter.title} />
                    </figure>
                </header>
                <div class="blog__content prose">
                    <slot />
                </div>
                <footer class="article__foot">
                    <a class="button" href="/projects"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to all projects</a>
                </footer>
            </div>
        </article>
    </main>
    <Footer />
    <button id="to-top" type="button" aria-label="Back to top"><i class="fa-solid fa-angle-up" aria-hidden="true"></i></button>
    <script src="../scripts/article.js"></script>
</body>
</html>
